#!/bin/bash
# Usage: ./setup
#
# Installs this repository's Herdr issues mod and its Claude Code plugin:
#   - links the mod folder (mod/) to $HERDR_APP_HOME/mods/issues (default ~/.config/herdr-app/mods/issues)
#   - adds the repository as the herdr-issues plugin marketplace and installs issues@herdr-issues,
#     which brings the issues:* skills and the Claude hooks
#   - adds the mod's keys (mod/keys.json) to $HERDR_APP_HOME/keys.json, keeping any key already bound
#     to something else
#   - offers to add the Issues panel to a personal layout's side panel, unless a layout already shows it
#   - links the issues CLI (bin/issues) to ~/.local/bin/issues
# Running it again re-links the mod and the CLI and updates the plugin to this checkout's version.
#
# Needs herdr-app, claude, git and node; gh is needed only for repositories tracked in GitHub Issues.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
mod_root="$repo_root/mod"
marketplace=herdr-issues
plugin="issues@$marketplace"
herdr_home="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
mod_link="$herdr_home/mods/issues"
keys_file="$herdr_home/keys.json"
cli_link="$HOME/.local/bin/issues"
setup_json="$repo_root/scripts/setup-json.js"

colors_stream() {
  [[ -t $1 && -z ${NO_COLOR:-} ]]
}

print_in_color() {
  local stream=$1 sgr=$2
  shift 2
  if colors_stream "$stream"; then
    printf '\e[%sm%s\e[0m\n' "$sgr" "$*" >&"$stream"
  else
    printf '%s\n' "$*" >&"$stream"
  fi
}

# Prompts from read -p and select go to stderr.
prompt_text() {
  if colors_stream 2; then
    printf '\e[36m%s\e[0m' "$1"
  else
    printf '%s' "$1"
  fi
}

success() { print_in_color 1 32 "$@"; }
info() { printf '%s\n' "$*"; }
note() { print_in_color 1 1 "$(cat)"; }
prompt() { print_in_color 1 36 "$@"; }
warning() { print_in_color 2 33 "$@"; }
error() { print_in_color 2 31 "$@"; }

missing=()
for command in herdr-app claude git node; do
  command -v "$command" >/dev/null || missing+=("$command")
done
if ((${#missing[@]})); then
  error "setup: missing required commands: ${missing[*]}"
  exit 1
fi
command -v gh >/dev/null || warning "setup: warning: gh is not installed; repositories tracked in GitHub Issues need it"

refuse_linked_worktree() {
  local git_dir common_dir main_checkout
  git_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-dir)
  common_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)
  [[ $git_dir == "$common_dir" ]] && return
  main_checkout=$(git -C "$repo_root" worktree list --porcelain | sed -n '1s/^worktree //p')
  error "setup: $repo_root is a linked worktree; installing from it would point the mod, the issues CLI and the plugin at a folder that goes away when the worktree closes"
  error "setup: run ./setup from the main checkout instead: cd $main_checkout && ./setup"
  exit 1
}
refuse_linked_worktree

link_mod() {
  if [[ -e $mod_link && ! -L $mod_link ]]; then
    error "setup: $mod_link exists and is not a symlink; move it aside and run setup again"
    exit 1
  fi
  mkdir -p "$(dirname "$mod_link")"
  ln -sfn "$mod_root" "$mod_link"
  success "Linked $mod_link -> $mod_root"
}

link_cli() {
  if [[ -e $cli_link && ! -L $cli_link ]]; then
    error "setup: $cli_link exists and is not a symlink; move it aside and run setup again"
    exit 1
  fi
  mkdir -p "$(dirname "$cli_link")"
  ln -sfn "$repo_root/bin/issues" "$cli_link"
  success "Linked $cli_link -> $repo_root/bin/issues"
  case ":$PATH:" in
    *":$(dirname "$cli_link"):"*) ;;
    *) warning "setup: warning: $(dirname "$cli_link") is not on PATH; add it to run the issues command" ;;
  esac
}

marketplace_path() {
  claude plugin marketplace list --json | node "$setup_json" marketplace-path "$marketplace"
}

plugin_installed() {
  claude plugin list --json | node "$setup_json" plugin-installed "$plugin"
}

install_plugin() {
  local registered_path
  registered_path=$(marketplace_path)
  if [[ -n $registered_path && $registered_path != "$repo_root" ]]; then
    info "The $marketplace marketplace points to $registered_path; pointing it to $repo_root"
    claude plugin marketplace remove "$marketplace"
    registered_path=""
  fi

  if [[ -z $registered_path ]]; then
    claude plugin marketplace add "$repo_root"
  else
    claude plugin marketplace update "$marketplace"
  fi

  if plugin_installed; then
    claude plugin update "$plugin"
  else
    claude plugin install "$plugin"
  fi
}

# Adds each of the mod's keys the person hasn't bound; a key they bound to another action stays theirs.
merge_keys() {
  if [[ ! -f $keys_file ]]; then
    warning "setup: $keys_file not found; open Herdr once and run setup again to add the mod's keys"
    return
  fi

  local kept status=0
  kept=$(node "$setup_json" merge-keys "$keys_file" "$mod_root/keys.json") || status=$?
  [[ -z $kept ]] || warning "$kept"
  case $status in
    0) success "Added the mod's keys to $keys_file" ;;
    10) success "$keys_file already has the mod's keys" ;;
    *) exit "$status" ;;
  esac
}

layout_shows_mod() {
  node "$setup_json" shows-mod "$1"
}

layout_has_panel_body() {
  node "$setup_json" has-panel-body "$1"
}

shipped_layout_names() {
  node "$setup_json" shipped-layouts "$herdr_home/installed.json"
}

print_manual_layout_steps() {
  note <<EOF
To show the Issues panel, make a personal copy of a layout and add the mod to its side panel:
  herdr-app do layout.clone '{"name":"main","as":"main-issues"}'
Then add this block to the children of the node whose id is panel-body in $layouts_dir/main-issues.json:
  { "id": "issues", "type": "block", "content": { "mod": "issues" } }
To keep the panel's share of the window as it resizes, give the node whose id is main "size": { "weight": 5 }
and the node whose id is panel "size": { "weight": 2 }.
EOF
}

add_block_to_panel_body() {
  node "$setup_json" add-panel "$1"
}

# Writes the copy itself instead of running layout.clone, which needs an open window and switches it to the copy.
copy_main_layout() {
  local name version
  while true; do
    read -r -p "$(prompt_text "Name for the new layout [main-issues]: ")" name || return 1
    name=${name:-main-issues}
    if [[ ! $name =~ ^[A-Za-z0-9._-]+$ ]]; then
      prompt "Use only letters, numbers, dots, dashes and underscores."
    elif [[ -e $layouts_dir/$name.json ]]; then
      prompt "$layouts_dir/$name.json already exists; choose another name."
    else
      break
    fi
  done
  version=$(herdr-app --version | awk '{ print $NF }')
  node "$setup_json" copy-layout "$layouts_dir/main.json" "$layouts_dir/$name.json" "$version"
  success "Copied the main layout to $layouts_dir/$name.json with the Issues panel"
  info "Switch to it with: herdr-app do layout.switch '{\"name\":\"$name\"}'"
}

# Adds the Issues panel to a personal layout the person picks; Herdr restores any edited shipped layout at its next start.
add_panel_to_layout() {
  layouts_dir="$herdr_home/layouts"
  if [[ ! -d $layouts_dir ]]; then
    warning "setup: $layouts_dir not found; open Herdr once and run setup again to add the Issues panel"
    return
  fi

  local layout_file name shipped showing=() candidates=()
  shipped=$(shipped_layout_names)
  for layout_file in "$layouts_dir"/*.json; do
    [[ -f $layout_file ]] || continue
    name=$(basename "$layout_file" .json)
    if layout_shows_mod "$layout_file"; then
      showing+=("$name")
    elif ! grep -qxF "$name" <<<"$shipped" && layout_has_panel_body "$layout_file"; then
      candidates+=("$name")
    fi
  done

  if ((${#showing[@]})); then
    success "The Issues panel is already in the ${showing[*]} layout"
    return
  fi

  if [[ ! -t 0 ]]; then
    print_manual_layout_steps
    return
  fi

  local copy_choice="Copy main into a new layout" skip_choice="Skip" choices=() choice
  ((${#candidates[@]})) && choices+=("${candidates[@]}")
  [[ -f $layouts_dir/main.json ]] && choices+=("$copy_choice")
  choices+=("$skip_choice")

  echo
  prompt "Which layout should show the Issues panel?"
  PS3=$(prompt_text "Choose a number: ")
  select choice in "${choices[@]}"; do
    [[ -n $choice ]] && break
  done
  case ${choice:-$skip_choice} in
    "$skip_choice")
      print_manual_layout_steps
      ;;
    "$copy_choice")
      copy_main_layout || print_manual_layout_steps
      ;;
    *)
      add_block_to_panel_body "$layouts_dir/$choice.json"
      success "Added the Issues panel to the $choice layout"
      ;;
  esac
}

link_mod
link_cli
merge_keys
install_plugin
add_panel_to_layout

echo
note <<EOF
Done. Start a new Claude Code session to load the plugin.
EOF
