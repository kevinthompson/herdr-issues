#!/bin/bash
# Usage: ./setup
#
# Installs this repository's Herdr issues mod and, when Claude Code is installed, its Claude Code plugin:
#   - runs `npm ci` for the development dependencies, which also installs the pre-commit hook, unless
#     SKIP_DEV_DEPENDENCIES is set, as the README's install sets it
#   - links the mod folder (mod/) to $HERDR_APP_HOME/mods/issues (default ~/.config/herdr-app/mods/issues),
#     repointing a link an older install made to the checkout itself
#   - adds the repository as the herdr-issues plugin marketplace and installs issues@herdr-issues,
#     which brings the issues:* skills and the Claude hooks; without claude it skips the plugin with a warning
#   - adds the mod's keys (mod/keys.json) to $HERDR_APP_HOME/keys.json, keeping any key already bound
#     to something else, except a binding an earlier version of the mod made, such as cmd-shift-i to
#     layout.toggle:panel
#   - offers to add the Issues panel in a column of its own beside the side panel of a personal layout, or of a
#     new copy of main, unless a layout already shows it, and moves the panel out of the side panel of a layout
#     an earlier setup put it in; it never writes a shipped layout, and asks nothing without a terminal
#   - when the layout with the Issues panel isn't the one Herdr shows, offers to switch to it, which Herdr then
#     opens with, or says how to switch
#   - links the issues CLI (bin/issues) to ~/.local/bin/issues, refusing to replace a file there that isn't a link
# It refuses in a linked worktree, whose folder goes away when the worktree closes.
# Running it again re-links the mod and the CLI and updates the plugin to this checkout's version, turning it
# back on if it was turned off.
#
# Needs herdr-app, git and node 22.15 or later, which it offers to install with devbox or Homebrew. Claude Code
# (claude) is needed only for the issues:* skills and hooks, and gh only for repositories tracked in GitHub Issues.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
mod_root="$repo_root/mod"
marketplace=herdr-issues
plugin="issues@$marketplace"
herdr_home="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
mod_link="$herdr_home/mods/issues"
keys_file="$herdr_home/keys.json"
cli_link="$HOME/.local/bin/issues"
setup_json="$repo_root/scripts/setup-json.js"

colors_stream() {
  [[ -t $1 && -z ${NO_COLOR:-} ]]
}

print_in_color() {
  local stream=$1 sgr=$2
  shift 2
  if colors_stream "$stream"; then
    printf '\e[%sm%s\e[0m\n' "$sgr" "$*" >&"$stream"
  else
    printf '%s\n' "$*" >&"$stream"
  fi
}

# Prompts from read -p and select go to stderr.
prompt_text() {
  if colors_stream 2; then
    printf '\e[36m%s\e[0m' "$1"
  else
    printf '%s' "$1"
  fi
}

success() { print_in_color 1 32 "$@"; }
info() { printf '%s\n' "$*"; }
note() { print_in_color 1 1 "$(cat)"; }
prompt() { print_in_color 1 36 "$@"; }
warning() { print_in_color 2 33 "$@"; }
error() { print_in_color 2 31 "$@"; }

missing=()
for command in herdr-app git; do
  command -v "$command" >/dev/null || missing+=("$command")
done
if ((${#missing[@]})); then
  error "setup: missing required commands: ${missing[*]}"
  exit 1
fi

# bin/issues calls module.registerHooks, which Node added in 22.15.
minimum_node_version=22.15

# Prints why node can't run the issues CLI, or nothing when it can.
node_problem() {
  local found_version minimum_major=${minimum_node_version%.*} minimum_minor=${minimum_node_version#*.}
  if ! command -v node >/dev/null; then
    echo "node is not installed"
    return
  fi
  found_version=$(node --version)
  found_version=${found_version#v}
  if [[ $found_version =~ ^([0-9]+)\.([0-9]+) ]]; then
    local major=${BASH_REMATCH[1]} minor=${BASH_REMATCH[2]}
    ((major > minimum_major || (major == minimum_major && minor >= minimum_minor))) && return
  fi
  echo "node $found_version is too old"
}

# Answers no without asking when standard input isn't a terminal.
confirm() {
  local answer
  [[ -t 0 ]] || return 1
  read -r -p "$(prompt_text "$1 [y/N] ")" answer || return 1
  [[ $answer == [yY]* ]]
}

devbox_lists_packages() {
  command -v devbox >/dev/null && devbox global list 2>/dev/null | grep -q '^\* '
}

node_install_command() {
  case $1 in
    devbox) echo "devbox global add nodejs" ;;
    brew) echo "brew install node" ;;
  esac
}

describe_node_install() {
  case $1 in
    devbox) info "  $(node_install_command devbox) adds Node to devbox's global packages, which shells find through devbox global shellenv." ;;
    brew) info "  $(node_install_command brew) installs Node with Homebrew for every shell, or upgrades the Node Homebrew already installed." ;;
  esac
}

# Herdr and Claude Code find devbox's global packages only through a shell profile that evaluates its shellenv.
warn_unless_profile_evaluates_devbox() {
  local zsh_home=${ZDOTDIR:-$HOME} profile
  for profile in "$zsh_home/.zshenv" "$zsh_home/.zprofile" "$zsh_home/.zshrc" "$HOME/.bash_profile" "$HOME/.bashrc" \
    "$HOME/.profile" "$HOME/.config/fish/config.fish"; do
    grep -qs 'devbox global shellenv' "$profile" && return
  done
  warning "setup: warning: your shell profile doesn't evaluate devbox global shellenv, so Herdr and Claude Code won't find node; add this line to it: eval \"\$(devbox global shellenv)\""
}

install_node_with() {
  local manager=$1 command
  command=$(node_install_command "$manager")
  info "Running $command"
  if ! $command; then
    error "setup: $command failed"
    return 1
  fi
  if [[ $manager == devbox ]]; then
    eval "$(devbox global shellenv)"
    warn_unless_profile_evaluates_devbox
  fi
  hash -r
}

# Offers to install Node with the person's package manager; fails when nothing was installed.
offer_node_install() {
  [[ -t 0 ]] || return 1
  local managers=() manager choice choices=() decline_choice="Don't install"
  devbox_lists_packages && managers+=(devbox)
  command -v brew >/dev/null && managers+=(brew)
  ((${#managers[@]})) || return 1

  prompt "setup: $1; the issues CLI needs Node $minimum_node_version or later."
  info "The issues command, which the Issues panel and the issues:* skills run, is a Node program."
  for manager in "${managers[@]}"; do
    describe_node_install "$manager"
  done
  if ((${#managers[@]} == 1)); then
    manager=${managers[0]}
    confirm "Install it with $manager ($(node_install_command "$manager"))?" || return 1
  else
    for manager in "${managers[@]}"; do
      choices+=("$manager ($(node_install_command "$manager"))")
    done
    prompt "Which package manager should install Node?"
    PS3=$(prompt_text "Choose a number: ")
    select choice in "${choices[@]}" "$decline_choice"; do
      [[ -n $choice ]] && break
    done
    [[ -n $choice && $choice != "$decline_choice" ]] || return 1
    manager=${choice%% *}
  fi
  install_node_with "$manager"
}

require_node() {
  local problem
  problem=$(node_problem)
  [[ -z $problem ]] && return
  offer_node_install "$problem" && problem=$(node_problem)
  [[ -z $problem ]] && return
  error "setup: $problem; the issues CLI needs Node $minimum_node_version or later"
  error "setup: install it, then run setup again"
  exit 1
}
require_node

command -v gh >/dev/null ||
  warning "setup: warning: gh, GitHub's command line tool, is not installed; without it the Issues panel and the issues command can't read or change issues in repositories tracked in GitHub Issues. Install it with brew install gh (or see https://cli.github.com), then sign in with gh auth login."

refuse_linked_worktree() {
  local git_dir common_dir main_checkout
  git_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-dir)
  common_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)
  [[ $git_dir == "$common_dir" ]] && return
  main_checkout=$(git -C "$repo_root" worktree list --porcelain | sed -n '1s/^worktree //p')
  error "setup: $repo_root is a linked worktree; installing from it would point the mod, the issues CLI and the plugin at a folder that goes away when the worktree closes"
  error "setup: run ./setup from the main checkout instead: cd $main_checkout && ./setup"
  exit 1
}
refuse_linked_worktree

link_mod() {
  if [[ -e $mod_link && ! -L $mod_link ]]; then
    error "setup: $mod_link exists and is not a symlink; move it aside and run setup again"
    exit 1
  fi
  mkdir -p "$(dirname "$mod_link")"
  ln -sfn "$mod_root" "$mod_link"
  success "Linked $mod_link -> $mod_root"
}

link_cli() {
  if [[ -e $cli_link && ! -L $cli_link ]]; then
    error "setup: $cli_link exists and is not a symlink; move it aside and run setup again"
    exit 1
  fi
  mkdir -p "$(dirname "$cli_link")"
  ln -sfn "$repo_root/bin/issues" "$cli_link"
  success "Linked $cli_link -> $repo_root/bin/issues"
  case ":$PATH:" in
    *":$(dirname "$cli_link"):"*) ;;
    *) warning "setup: warning: $(dirname "$cli_link") is not on PATH; add it to run the issues command" ;;
  esac
}

# bootstrap gives setup a standard input opened from /dev/tty, which macOS's kqueue rejects, and the
# claude binary crashes trying to watch it; its plugin commands never read input.
claude_plugin() {
  claude plugin "$@" </dev/null
}

marketplace_path() {
  claude_plugin marketplace list --json | node "$setup_json" marketplace-path "$marketplace"
}

plugin_installed() {
  claude_plugin list --json | node "$setup_json" plugin-installed "$plugin"
}

plugin_enabled() {
  claude_plugin list --json | node "$setup_json" plugin-enabled "$plugin"
}

install_plugin() {
  if ! command -v claude >/dev/null; then
    warning "setup: warning: claude is not installed, so the Claude plugin with the issues:* skills and hooks was skipped; install Claude Code and run setup again to add it. Without it, the Issues panel still lists issues, but Claude Code sessions can't work them with skills such as /issues:work. Claude Code installs with: curl -fsSL https://claude.ai/install.sh | bash"
    return
  fi

  local registered_path
  registered_path=$(marketplace_path)
  if [[ -n $registered_path && $registered_path != "$repo_root" ]]; then
    info "The $marketplace marketplace points to $registered_path; pointing it to $repo_root"
    claude_plugin marketplace remove "$marketplace"
    registered_path=""
  fi

  if [[ -z $registered_path ]]; then
    claude_plugin marketplace add "$repo_root"
  else
    claude_plugin marketplace update "$marketplace"
  fi

  if plugin_installed; then
    claude_plugin update "$plugin"
    if ! plugin_enabled; then
      info "The $plugin plugin was turned off; turning it on"
      claude_plugin enable "$plugin" --scope user
    fi
  else
    claude_plugin install "$plugin"
  fi
}

# Adds each of the mod's keys the person hasn't bound; a key they bound to another action stays theirs.
merge_keys() {
  if [[ ! -f $keys_file ]]; then
    warning "setup: $keys_file not found; Herdr writes it the first time it opens. Without it the mod's keys, such as cmd-shift-i to show or hide the Issues panel, aren't bound. Open Herdr once and run setup again to add them."
    return
  fi

  local kept status=0
  kept=$(node "$setup_json" merge-keys "$keys_file" "$mod_root/keys.json") || status=$?
  [[ -z $kept ]] || warning "$kept"
  case $status in
    0) success "Added the mod's keys to $keys_file" ;;
    10) success "$keys_file already has the mod's keys" ;;
    *) exit "$status" ;;
  esac
}

layout_shows_mod() {
  node "$setup_json" shows-mod "$1"
}

layout_has_panel_body() {
  node "$setup_json" has-panel-body "$1"
}

shipped_layout_names() {
  node "$setup_json" shipped-layouts "$herdr_home/installed.json"
}

print_manual_layout_steps() {
  note <<EOF
No layout shows the Issues panel yet, so Herdr won't show it. Herdr's shipped layouts can't be changed, since
Herdr replaces them each time it starts, so the panel goes in a personal layout.
To show the Issues panel, make a personal copy of a layout and add the mod beside its side panel:
  herdr-app do layout.clone '{"name":"main","as":"main-issues"}'
Then add this column right after the node whose id is panel in $layouts_dir/main-issues.json:
  { "id": "issues-panel", "type": "column", "size": { "weight": 1 }, "min": 32, "max": 900,
    "children": [{ "id": "issues", "type": "block", "content": { "mod": "issues" } }] }
and give the node whose id is main "size": { "weight": 2 }, so the panel keeps its share as the window resizes.
EOF
}

add_panel_beside_panel_body() {
  node "$setup_json" add-panel "$1"
}

# Earlier versions of setup put the Issues panel inside panel-body, where collapsing it would shrink Files and Changes,
# then in a column fixed at 368px, which kept its width as the window resized.
move_panel_out_of_panel_body() {
  local status=0
  node "$setup_json" move-panel "$1" || status=$?
  case $status in
    0) success "Gave the Issues panel in the $(basename "$1" .json) layout a column that keeps its share of the window" ;;
    10) ;;
    *) exit "$status" ;;
  esac
}

shown_layout() {
  node "$setup_json" shown-layout "$herdr_home/shared.json"
}

# Herdr keeps showing the layout it last showed, so the layout switched to stays the one it opens with.
show_layout() {
  local window_layout
  window_layout=$(herdr-app status 2>/dev/null </dev/null | node "$setup_json" window-layout)
  if [[ -n $window_layout ]]; then
    herdr-app 'do' layout.switch "{\"name\":\"$1\"}" >/dev/null
  else
    node "$setup_json" show-layout "$herdr_home/shared.json" "$1"
  fi
  success "Herdr now shows the $1 layout, and opens with it until you switch layouts"
}

switch_layout_command() {
  printf "herdr-app do layout.switch '{\"name\":\"%s\"}'" "$1"
}

# Asks to show the layout with the Issues panel in place of the one Herdr shows, or says how to switch to it.
offer_to_show_layout() {
  local shown=$1 with_panel=$2
  if [[ -t 0 ]]; then
    echo
    info "Herdr opens with the layout it showed last, so switching to $with_panel now also makes it the layout Herdr opens with, until you switch layouts again with ctrl-shift-l."
  fi
  if confirm "Herdr shows the $shown layout, which has no Issues panel. Switch to $with_panel, which has it, and open with it from now on?"; then
    show_layout "$with_panel"
  else
    warning "The Issues panel is in the $with_panel layout, but Herdr shows the $shown layout; switch to it with: $(switch_layout_command "$with_panel")"
  fi
}

# Writes the copy itself instead of running layout.clone, which needs an open window and switches it to the copy.
copy_main_layout() {
  local name version
  echo
  info "The new layout's name is how you switch to it, with herdr-app do layout.switch or by cycling layouts with ctrl-shift-l. Setup writes it to $layouts_dir/<name>.json."
  while true; do
    read -r -p "$(prompt_text "Name for the new layout [main-issues]: ")" name || return 1
    name=${name:-main-issues}
    if [[ ! $name =~ ^[A-Za-z0-9._-]+$ ]]; then
      prompt "Use only letters, numbers, dots, dashes and underscores."
    elif [[ -e $layouts_dir/$name.json ]]; then
      prompt "$layouts_dir/$name.json already exists; choose another name."
    else
      break
    fi
  done
  version=$(herdr-app --version | awk '{ print $NF }')
  node "$setup_json" copy-layout "$layouts_dir/main.json" "$layouts_dir/$name.json" "$version"
  success "Copied the main layout to $layouts_dir/$name.json with the Issues panel"
  layout_with_panel=$name
}

# Adds the Issues panel to a personal layout the person picks; Herdr restores any edited shipped layout at its next start.
add_panel_to_layout() {
  layouts_dir="$herdr_home/layouts"
  if [[ ! -d $layouts_dir ]]; then
    warning "setup: $layouts_dir not found; Herdr writes its layouts there the first time it opens. Without a layout that shows it, the Issues panel doesn't appear. Open Herdr once and run setup again to add the Issues panel."
    return
  fi

  local layout_file name shipped shown showing=() candidates=()
  shipped=$(shipped_layout_names)
  shown=$(shown_layout)
  for layout_file in "$layouts_dir"/*.json; do
    [[ -f $layout_file ]] || continue
    name=$(basename "$layout_file" .json)
    if layout_shows_mod "$layout_file"; then
      showing+=("$name")
      grep -qxF "$name" <<<"$shipped" || move_panel_out_of_panel_body "$layout_file"
    elif ! grep -qxF "$name" <<<"$shipped" && layout_has_panel_body "$layout_file"; then
      if [[ $name == "$shown" ]]; then
        candidates=("$name" ${candidates[@]+"${candidates[@]}"})
      else
        candidates+=("$name")
      fi
    fi
  done

  if ((${#showing[@]})); then
    if printf '%s\n' "${showing[@]}" | grep -qxF "$shown"; then
      success "The Issues panel is in the $shown layout, which Herdr shows"
    else
      offer_to_show_layout "$shown" "${showing[0]}"
    fi
    return
  fi

  if [[ ! -t 0 ]]; then
    print_manual_layout_steps
    return
  fi

  local copy_choice="Copy main into a new layout" skip_choice="Skip" labels=() choice
  for name in ${candidates[@]+"${candidates[@]}"}; do
    if [[ $name == "$shown" ]]; then labels+=("$name (shown now)"); else labels+=("$name"); fi
  done
  [[ -f $layouts_dir/main.json ]] && labels+=("$copy_choice")
  labels+=("$skip_choice")

  echo
  if ((${#candidates[@]} == 0)) && [[ -f $layouts_dir/main.json ]]; then
    info "Herdr ships with a main layout that can't be changed, since Herdr replaces it each time it starts. You don't have a personal layout to add the Issues panel to."
    info "Copy main into a new layout makes a personal copy of main with the Issues panel in a column beside its side panel, under a name you choose next."
    info "Skip changes no layout and prints the steps to add the Issues panel yourself."
    prompt "Would you like to create a new personal layout with the Issues panel?"
  else
    info "A layout is the arrangement of Herdr's window: where its spaces, terminals and side panel go. Herdr shows one layout at a time, and the Issues panel appears only in a layout that has it."
    ((${#candidates[@]} == 0)) ||
      info "Choosing one of your personal layouts adds the Issues panel to it, in a column of its own beside the side panel."
    [[ ! -f $layouts_dir/main.json ]] ||
      info "Copy main into a new layout leaves your layouts as they are and makes a personal copy of main with the Issues panel, under a name you choose next."
    info "Skip changes no layout and prints the steps to add the Issues panel yourself."
    prompt "Herdr shows the $shown layout. Which layout should show the Issues panel?"
  fi
  PS3=$(prompt_text "Choose a number: ")
  select choice in "${labels[@]}"; do
    [[ -n $choice ]] && break
  done
  local layout_with_panel=""
  case ${choice:-$skip_choice} in
    "$skip_choice")
      print_manual_layout_steps
      ;;
    "$copy_choice")
      copy_main_layout || print_manual_layout_steps
      ;;
    *)
      layout_with_panel=${candidates[REPLY - 1]}
      add_panel_beside_panel_body "$layouts_dir/$layout_with_panel.json"
      success "Added the Issues panel to the $layout_with_panel layout"
      ;;
  esac
  [[ -z $layout_with_panel || $layout_with_panel == "$shown" ]] || offer_to_show_layout "$shown" "$layout_with_panel"
}

# The README's install needs none of this: install sets SKIP_DEV_DEPENDENCIES, since the dependencies only
# run the checks and the pre-commit hook that `npm ci`'s prepare script installs.
install_dev_dependencies() {
  [[ -z ${SKIP_DEV_DEPENDENCIES:-} && -f $repo_root/package-lock.json ]] || return 0
  (cd "$repo_root" && npm ci --silent)
  success "Installed the development dependencies and the pre-commit hook"
}

install_dev_dependencies
link_mod
link_cli
merge_keys
install_plugin
add_panel_to_layout

echo
if command -v claude >/dev/null; then
  note <<<"Done. Start a new Claude Code session to load the plugin."
else
  note <<<"Done."
fi
