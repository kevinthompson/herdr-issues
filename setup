#!/bin/bash
# Usage: ./setup
#
# Installs this repository's Herdr issues mod and its Claude Code plugin:
#   - links the mod folder (mod/) to $HERDR_APP_HOME/mods/issues (default ~/.config/herdr-app/mods/issues)
#   - adds the repository as the herdr-issues plugin marketplace and installs issues@herdr-issues,
#     which brings the issues:* skills and the Claude hooks
#   - adds the mod's keys (mod/keys.json) to $HERDR_APP_HOME/keys.json, keeping any key already bound
#     to something else
#   - offers to add the Issues panel to a personal layout's side panel, unless a layout already shows it
#   - links the issues CLI (bin/issues) to ~/.local/bin/issues
# Running it again re-links the mod and the CLI and updates the plugin to this checkout's version.
#
# Needs herdr-app, claude, jq, git and node; gh is needed only for repositories tracked in GitHub Issues.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
mod_root="$repo_root/mod"
marketplace=herdr-issues
plugin="issues@$marketplace"
herdr_home="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
mod_link="$herdr_home/mods/issues"
keys_file="$herdr_home/keys.json"
cli_link="$HOME/.local/bin/issues"

missing=()
for command in herdr-app claude jq git node; do
  command -v "$command" >/dev/null || missing+=("$command")
done
if ((${#missing[@]})); then
  echo "setup: missing required commands: ${missing[*]}" >&2
  exit 1
fi
command -v gh >/dev/null || echo "setup: warning: gh is not installed; repositories tracked in GitHub Issues need it" >&2

refuse_linked_worktree() {
  local git_dir common_dir main_checkout
  git_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-dir)
  common_dir=$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)
  [[ $git_dir == "$common_dir" ]] && return
  main_checkout=$(git -C "$repo_root" worktree list --porcelain | sed -n '1s/^worktree //p')
  echo "setup: $repo_root is a linked worktree; installing from it would point the mod, the issues CLI and the plugin at a folder that goes away when the worktree closes" >&2
  echo "setup: run ./setup from the main checkout instead: cd $main_checkout && ./setup" >&2
  exit 1
}
refuse_linked_worktree

link_mod() {
  if [[ -e $mod_link && ! -L $mod_link ]]; then
    echo "setup: $mod_link exists and is not a symlink; move it aside and run setup again" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$mod_link")"
  ln -sfn "$mod_root" "$mod_link"
  echo "Linked $mod_link -> $mod_root"
}

link_cli() {
  if [[ -e $cli_link && ! -L $cli_link ]]; then
    echo "setup: $cli_link exists and is not a symlink; move it aside and run setup again" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$cli_link")"
  ln -sfn "$repo_root/bin/issues" "$cli_link"
  echo "Linked $cli_link -> $repo_root/bin/issues"
  case ":$PATH:" in
    *":$(dirname "$cli_link"):"*) ;;
    *) echo "setup: warning: $(dirname "$cli_link") is not on PATH; add it to run the issues command" >&2 ;;
  esac
}

marketplace_path() {
  claude plugin marketplace list --json | jq -r --arg name "$marketplace" '.[] | select(.name == $name) | .path // .installLocation // empty'
}

plugin_installed() {
  claude plugin list --json | jq -e --arg id "$plugin" 'any(.[]; .id == $id)' >/dev/null
}

install_plugin() {
  local registered_path
  registered_path=$(marketplace_path)
  if [[ -n $registered_path && $registered_path != "$repo_root" ]]; then
    echo "The $marketplace marketplace points to $registered_path; pointing it to $repo_root"
    claude plugin marketplace remove "$marketplace"
    registered_path=""
  fi

  if [[ -z $registered_path ]]; then
    claude plugin marketplace add "$repo_root"
  else
    claude plugin marketplace update "$marketplace"
  fi

  if plugin_installed; then
    claude plugin update "$plugin"
  else
    claude plugin install "$plugin"
  fi
}

# Adds each of the mod's keys the person hasn't bound; a key they bound to another action stays theirs.
merge_keys() {
  if [[ ! -f $keys_file ]]; then
    echo "setup: $keys_file not found; open Herdr once and run setup again to add the mod's keys" >&2
    return
  fi

  local skipped merged
  skipped=$(jq -r --slurpfile mod "$mod_root/keys.json" '
    . as $mine | $mod[0] | to_entries[] | .key as $section | .value | to_entries[]
    | select($mine[$section][.key] != null and $mine[$section][.key] != .value)
    | "setup: kept your \(.key) in \($section) (\($mine[$section][.key] | tojson)); the mod expects \(.value | tojson)"
  ' "$keys_file")
  [[ -z $skipped ]] || echo "$skipped" >&2

  merged=$(jq --slurpfile mod "$mod_root/keys.json" '
    reduce ($mod[0] | to_entries[]) as $section (.;
      reduce ($section.value | to_entries[]) as $key (.;
        if .[$section.key][$key.key] == null then .[$section.key][$key.key] = $key.value else . end))
  ' "$keys_file")
  if jq -e --argjson merged "$merged" '. == $merged' "$keys_file" >/dev/null; then
    echo "$keys_file already has the mod's keys"
    return
  fi
  # Redirecting into the path writes through a symlinked keys.json instead of replacing the link.
  printf '%s\n' "$merged" >"$keys_file"
  echo "Added the mod's keys to $keys_file"
}

layout_shows_mod() {
  jq -e 'any(.. | objects; .content.mod? == "issues")' "$1" >/dev/null 2>&1
}

layout_has_panel_body() {
  jq -e 'any(.. | objects; .id? == "panel-body")' "$1" >/dev/null 2>&1
}

shipped_layout_names() {
  jq -r 'keys[] | select(startswith("layout:")) | ltrimstr("layout:")' "$herdr_home/installed.json" 2>/dev/null || true
}

print_manual_layout_steps() {
  cat <<EOF
To show the Issues panel, make a personal copy of a layout and add the mod to its side panel:
  herdr-app do layout.clone '{"name":"main","as":"main-issues"}'
Then add this block to the children of the node whose id is panel-body in $layouts_dir/main-issues.json:
  { "id": "issues", "type": "block", "content": { "mod": "issues" } }
EOF
}

# Redirecting into the path writes through a symlinked layout instead of replacing the link.
add_block_to_panel_body() {
  local layout_file=$1 updated
  updated=$(jq --argjson block "$issues_block" '(.. | objects | select(.id? == "panel-body") | .children) += [$block]' "$layout_file")
  printf '%s\n' "$updated" >"$layout_file"
}

# Writes the copy itself instead of running layout.clone, which needs an open window and switches it to the copy.
copy_main_layout() {
  local name version
  while true; do
    read -r -p "Name for the new layout [main-issues]: " name || return 1
    name=${name:-main-issues}
    if [[ ! $name =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "Use only letters, numbers, dots, dashes and underscores."
    elif [[ -e $layouts_dir/$name.json ]]; then
      echo "$layouts_dir/$name.json already exists; choose another name."
    else
      break
    fi
  done
  version=$(herdr-app --version | awk '{ print $NF }')
  jq --arg version "$version" '. + { cloned_from: { name: "main", version: $version } }' "$layouts_dir/main.json" >"$layouts_dir/$name.json"
  add_block_to_panel_body "$layouts_dir/$name.json"
  echo "Copied the main layout to $layouts_dir/$name.json with the Issues panel"
  echo "Switch to it with: herdr-app do layout.switch '{\"name\":\"$name\"}'"
}

# Adds the Issues panel to a personal layout the person picks; Herdr restores any edited shipped layout at its next start.
add_panel_to_layout() {
  layouts_dir="$herdr_home/layouts"
  issues_block='{ "id": "issues", "type": "block", "content": { "mod": "issues" } }'
  if [[ ! -d $layouts_dir ]]; then
    echo "setup: $layouts_dir not found; open Herdr once and run setup again to add the Issues panel" >&2
    return
  fi

  local layout_file name shipped showing=() candidates=()
  shipped=$(shipped_layout_names)
  for layout_file in "$layouts_dir"/*.json; do
    [[ -f $layout_file ]] || continue
    name=$(basename "$layout_file" .json)
    if layout_shows_mod "$layout_file"; then
      showing+=("$name")
    elif ! grep -qxF "$name" <<<"$shipped" && layout_has_panel_body "$layout_file"; then
      candidates+=("$name")
    fi
  done

  if ((${#showing[@]})); then
    echo "The Issues panel is already in the ${showing[*]} layout"
    return
  fi

  if [[ ! -t 0 ]]; then
    print_manual_layout_steps
    return
  fi

  local copy_choice="Copy main into a new layout" skip_choice="Skip" choices=() choice
  ((${#candidates[@]})) && choices+=("${candidates[@]}")
  [[ -f $layouts_dir/main.json ]] && choices+=("$copy_choice")
  choices+=("$skip_choice")

  echo
  echo "Which layout should show the Issues panel?"
  PS3="Choose a number: "
  select choice in "${choices[@]}"; do
    [[ -n $choice ]] && break
  done
  case ${choice:-$skip_choice} in
    "$skip_choice")
      print_manual_layout_steps
      ;;
    "$copy_choice")
      copy_main_layout || print_manual_layout_steps
      ;;
    *)
      add_block_to_panel_body "$layouts_dir/$choice.json"
      echo "Added the Issues panel to the $choice layout"
      ;;
  esac
}

link_mod
link_cli
merge_keys
install_plugin
add_panel_to_layout

cat <<EOF

Done. Start a new Claude Code session to load the plugin.
If you installed by hand before, remove the old links so skills and the scope hook don't load twice:
  ~/.claude/skills/issues, ~/.claude/hooks/herdr-issues-scope.sh and its UserPromptSubmit entry in ~/.claude/settings.json
EOF
