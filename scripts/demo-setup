#!/bin/bash
# Usage: scripts/demo-setup [--teardown]
#
# Builds two demo projects for recording the issues panel, blog and recipe-app, under $DEMO_ROOT (default
# ~/Demo). Each is a git repository with its issues in a local Beads database, an entry in issues.json that
# merges its branches locally, a Herdr space, and a nested worktree space for each issue in progress. Each
# commits a .claude/settings.json whose status line prints nothing, so Claude sessions in it and its worktrees
# show none.
#
# Running it again tears the projects down and builds them afresh. --teardown only tears them down: it closes
# their spaces, removes their worktrees and repositories, and removes their issues.json entries. It deletes a
# project folder only when it holds the .herdr-demo marker this script writes.
#
# Needs bd, herdr-app, hc, issues, git and node, with the Herdr app running. It runs this checkout's issues CLI,
# while the panel's Start runs the installed one.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
setup_json="$repo_root/scripts/setup-json.js"
issues_cli="$repo_root/bin/issues"
demo_root="${DEMO_ROOT:-$HOME/Demo}"
settings="${HERDR_APP_HOME:-$HOME/.config/herdr-app}/issues.json"
marker=.herdr-demo
projects=(blog recipe-app)

fail() {
  printf 'demo-setup: %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
  "") teardown_only=false ;;
  --teardown) teardown_only=true ;;
  *) fail "unknown argument $1; usage: scripts/demo-setup [--teardown]" ;;
esac

missing=()
for command in bd herdr-app hc issues git node; do
  command -v "$command" >/dev/null || missing+=("$command")
done
((${#missing[@]} == 0)) || fail "missing required commands: ${missing[*]}"

# Every checkout of the repository at $1, the main checkout first.
checkouts_of() {
  git -C "$1" worktree list --porcelain | sed -n 's/^worktree //p'
}

close_spaces_in() {
  local listing id
  listing=$(herdr-app ls 2>/dev/null) || return 0
  # A space closed with its parent is already gone, so a failed close is fine.
  node "$setup_json" spaces-in "$@" <<<"$listing" | while read -r id; do
    herdr-app "do" space.close "{\"id\":\"$id\",\"confirmed\":true}" >/dev/null 2>&1 || true
  done
}

teardown_project() {
  local path="$demo_root/$1" checkout checkouts=()
  [[ -e $path ]] || return 0
  [[ -f $path/$marker ]] || fail "$path has no $marker marker, so this script didn't make it; move it or set DEMO_ROOT"
  while read -r checkout; do checkouts+=("$checkout"); done < <(checkouts_of "$path")
  close_spaces_in "${checkouts[@]}"
  for checkout in "${checkouts[@]:1}"; do
    git -C "$path" worktree remove --force --force "$checkout"
    rmdir "$(dirname "$checkout")" 2>/dev/null || true
  done
  rm -rf "$path"
  echo "removed $path"
}

teardown() {
  local project paths=() demo_folder
  demo_folder=$(cd "$demo_root" 2>/dev/null && pwd -P) || demo_folder=$demo_root
  for project in "${projects[@]}"; do
    teardown_project "$project"
    paths+=("$demo_folder/$project")
  done
  node "$setup_json" remove-repos "$settings" "${paths[@]}"
  rmdir "$demo_root" 2>/dev/null || true
}

# Writes stdin to the file $1 inside the project folder $2, making its folders.
write_file() {
  mkdir -p "$(dirname "$2/$1")"
  cat >"$2/$1"
}

create_repository() {
  local path=$1 name=$2 prefix=$3 file
  shift 3
  mkdir -p "$path"
  : >"$path/$marker"
  git -C "$path" init -q -b main
  echo "$marker" >>"$path/.git/info/exclude"
  printf '# %s\n\nA demo project for the Herdr issues panel.\n' "$name" | write_file README.md "$path"
  for file in "$@"; do echo "Placeholder" | write_file "$file" "$path"; done
  write_file .claude/settings.json "$path" <<'EOF'
{
  "statusLine": { "type": "command", "command": "true" }
}
EOF
  git -C "$path" add -A
  git -C "$path" commit -q -m "Initial commit"
  (cd "$path" && bd init --stealth --non-interactive --prefix "$prefix" >/dev/null)
  node "$setup_json" set-repo "$settings" "$path" '{"tracker":"beads","merge":"auto"}'
}

# Creates each issue on stdin, one per line: number|title|label|priority (0-4)|status|blocking number|description|task
create_issues() {
  local path=$1 prefix=$2 number title label priority status blocker description task
  while IFS='|' read -r number title label priority status blocker description task; do
    (cd "$path" && bd create "$title" --id "$prefix-$number" --labels "$label" --priority "$priority" --status "$status" \
      --description "$description"$'\n\n'"- [ ] $task" ${blocker:+--deps "blocked-by:$prefix-$blocker"} --silent >/dev/null)
  done
}

# Commits a change on the issue's branch and merges it into main, so its worktree is ready to close.
merge_issue_branch() {
  local path=$1 id=$2 file=$3 message=$4 branch
  branch=$(cd "$path" && "$issues_cli" branch "$id")
  git -C "$path" switch -q -c "$branch"
  echo "Placeholder, changed on $branch" | write_file "$file" "$path"
  git -C "$path" commit -q -am "$message"
  git -C "$path" switch -q main
  git -C "$path" merge -q --no-ff -m "Merge branch '$branch'" "$branch"
}

open_space() {
  herdr-app "do" space.new --name "$2" --folder "$1" >/dev/null
}

open_issue_worktree() {
  (cd "$1" && "$issues_cli" worktree "$2" >/dev/null)
}

build_recipe_app() {
  local path
  mkdir -p "$demo_root"
  path="$(cd "$demo_root" && pwd -P)/recipe-app"
  create_repository "$path" recipe-app recipe src/app.js src/recipes.js
  create_issues "$path" recipe <<'EOF'
1|Scale ingredient amounts by serving count|data|1|in_progress||Recalculate each ingredient amount when the serving count changes.|Scale amounts on the recipe page
2|Fix fraction rounding in ingredient lists|bug|0|open||Scaled amounts show long decimals instead of simple fractions.|Round amounts to the nearest common fraction
3|Search recipes by ingredient|search|1|open||Find the recipes that use a given ingredient.|Add an ingredient search field
4|Build a shopping list from a week's recipes|data|2|open|1|Combine the ingredients of a week's recipes into one list.|Merge matching ingredients
5|Add a print layout for recipes|ui|3|open||Print a recipe on one page without the navigation.|Add a print stylesheet
6|Import recipes from a URL|data|3|deferred||Read a recipe from a web page's structured data.|Parse recipe data from a URL
7|Show cooking times on recipe cards|ui|4|closed||Show the total cooking time on each recipe card.|Add the time to the card
EOF
  open_space "$path" recipe-app
  open_issue_worktree "$path" recipe-1
  echo "built $path"
}

build_blog() {
  local path
  mkdir -p "$demo_root"
  path="$(cd "$demo_root" && pwd -P)/blog"
  create_repository "$path" blog blog src/index.html src/archive.html
  create_issues "$path" blog <<'EOF'
1|Fix broken links on the archive page|bug|0|in_progress||Links to older posts on the archive page lead to missing pages.|Point archive links at the current post addresses
2|Add an RSS feed|infra|1|in_progress||Publish a feed of recent posts so readers can subscribe.|Generate the feed during the build
3|Add tags to posts|content|2|open||Let each post list a few tags.|Show a post's tags under its title
4|Show a tag cloud in the sidebar|design|3|open|3|List every tag in the sidebar, sized by how many posts use it.|Add the tag cloud to the sidebar
5|Compress images during the build|infra|2|open||Large images slow down page loads.|Compress images in the build step
6|Add a dark theme|design|4|deferred||Offer a dark color scheme that follows the system setting.|Add the dark theme's colors
7|Set up the static site generator|infra|4|closed||Build the site's pages from Markdown files.|Add the build script
8|Write the about page|content|4|closed||Add a page about the blog.|Add the about page
EOF
  merge_issue_branch "$path" blog-1 src/archive.html "Fix broken links on the archive page"
  open_space "$path" blog
  open_issue_worktree "$path" blog-1
  open_issue_worktree "$path" blog-2
  herdr-app ls | node "$setup_json" spaces-in "$path" | head -1 | while read -r id; do
    herdr-app "do" space.select --id "$id" >/dev/null
  done
  echo "built $path"
}

if $teardown_only; then
  teardown
else
  herdr-app ls >/dev/null 2>&1 || fail "the Herdr app isn't running; open it and run this again"
  teardown
  build_recipe_app
  build_blog
fi
