#!/bin/sh
# Stands in for macOS's security command under test, so no test reads or writes the person's Keychain. It
# keeps each generic password as a file under $HOME/.test-keychain, and answers the add, find and delete
# commands the mod and uninstall run, with the exit code 44 security gives for a missing item.
command=$1
shift
service='' account='' password='' print_password=''
while [ $# -gt 0 ]; do
  case $1 in
    -s) service=$2; shift 2 ;;
    -a) account=$2; shift 2 ;;
    -w)
      if [ "$command" = add-generic-password ]; then password=$2; shift 2; else print_password=1; shift; fi ;;
    *) shift ;;
  esac
done

item="$HOME/.test-keychain/$service-$account"
not_found() {
  echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2
  exit 44
}

case $command in
  add-generic-password)
    mkdir -p "$HOME/.test-keychain"
    printf '%s' "$password" >"$item" ;;
  find-generic-password)
    [ -f "$item" ] || not_found
    if [ -n "$print_password" ]; then cat "$item"; echo; else echo "keychain: \"test\""; fi ;;
  delete-generic-password)
    [ -f "$item" ] || not_found
    rm "$item" ;;
  *)
    echo "security: unknown command $command" >&2
    exit 1 ;;
esac
